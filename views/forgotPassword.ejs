<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>
    Forgot Password
  </title>

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />

  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:"Poppins",sans-serif;
    }

    body{

      min-height:100vh;

      display:flex;
      justify-content:center;
      align-items:center;

      overflow:hidden;

      background:
        linear-gradient(
          135deg,
          #4f46e5,
          #7c3aed,
          #06b6d4
        );

      position:relative;
    }

    /* Animated Background */

    .blob{
      position:absolute;
      border-radius:50%;
      filter:blur(45px);
      opacity:0.6;
      animation:float 10s infinite ease-in-out;
    }

    .blob1{
      width:320px;
      height:320px;
      background:#ff6b6b;
      top:-100px;
      left:-120px;
    }

    .blob2{
      width:260px;
      height:260px;
      background:#ffd93d;
      bottom:-80px;
      right:-80px;
      animation-delay:2s;
    }

    .blob3{
      width:200px;
      height:200px;
      background:#6bcBef;
      top:55%;
      left:65%;
      animation-delay:4s;
    }

    @keyframes float{

      0%{
        transform:
          translateY(0px)
          scale(1);
      }

      50%{
        transform:
          translateY(-30px)
          scale(1.1);
      }

      100%{
        transform:
          translateY(0px)
          scale(1);
      }

    }

    /* Card */

    .container{

      width:90%;
      max-width:420px;

      padding:45px;

      border-radius:24px;

      background:
        rgba(255,255,255,0.14);

      backdrop-filter:blur(20px);

      border:
        1px solid rgba(255,255,255,0.2);

      box-shadow:
        0 8px 32px rgba(0,0,0,0.25);

      position:relative;
      z-index:10;

      animation:fadeIn 1s ease;
    }

    @keyframes fadeIn{

      from{
        opacity:0;
        transform:translateY(30px);
      }

      to{
        opacity:1;
        transform:translateY(0);
      }

    }

    h1{

      color:white;

      text-align:center;

      font-size:2rem;

      margin-bottom:12px;

      font-weight:700;
    }

    .subtitle{

      color:rgba(255,255,255,0.8);

      text-align:center;

      font-size:14px;

      line-height:1.6;

      margin-bottom:30px;
    }

    .error{

      background:
        rgba(255,0,0,0.15);

      color:white;

      padding:12px;

      border-radius:12px;

      margin-bottom:20px;

      text-align:center;

      border:
        1px solid rgba(255,255,255,0.15);
    }

    form{

      display:flex;
      flex-direction:column;
      gap:20px;
    }

    .input-group{
      position:relative;
    }

    input{

      width:100%;

      padding:16px 18px;

      border:none;
      outline:none;

      border-radius:14px;

      background:
        rgba(255,255,255,0.12);

      color:white;

      font-size:15px;

      transition:0.3s ease;

      border:
        1px solid transparent;
    }

    input::placeholder{
      color:rgba(255,255,255,0.7);
    }

    input:focus{

      border-color:white;

      transform:scale(1.02);

      box-shadow:
        0 0 15px rgba(255,255,255,0.3);
    }

    button{

      padding:16px;

      border:none;
      outline:none;

      border-radius:14px;

      background:white;

      color:#4f46e5;

      font-size:16px;
      font-weight:700;

      cursor:pointer;

      transition:0.3s ease;
    }

    button:hover{

      transform:translateY(-3px);

      box-shadow:
        0 10px 20px rgba(0,0,0,0.2);

      background:#f3f4f6;
    }

    .back-link{

      display:block;

      margin-top:22px;

      text-align:center;

      color:white;

      text-decoration:none;

      font-weight:500;

      transition:0.3s ease;
    }

    .back-link:hover{
      opacity:0.8;
    }

    @media(max-width:500px){

      .container{
        padding:30px;
      }

      h1{
        font-size:1.6rem;
      }

    }

  </style>

</head>

<body>

  <!-- Animated Blobs -->

  <div class="blob blob1"></div>
  <div class="blob blob2"></div>
  <div class="blob blob3"></div>

  <!-- Main Card -->

  <div class="container">

    <h1>
      Forgot Password
    </h1>

    <p class="subtitle">
      Enter your registered email address.
      We’ll send you a secure reset link.
    </p>

    <% if(error){ %>

      <div class="error">
        <%= error %>
      </div>

    <% } %>

    <form
      action="/forgot-password"
      method="POST"
    >

      <div class="input-group">

        <input
          type="email"
          name="email"
          placeholder="Enter Your Email"
          autocomplete="email"
          required
        />

      </div>

      <button type="submit">
        Send Reset Link
      </button>

    </form>

    <a
      href="/login"
      class="back-link"
    >
      ← Back to Login
    </a>

  </div>

</body>

</html>