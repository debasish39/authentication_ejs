<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>
    Login
  </title>

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />

  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:"Poppins",sans-serif;
    }

    body{

      min-height:100vh;

      display:flex;
      justify-content:center;
      align-items:center;

      overflow-x:hidden;

      background:
        conic-gradient(
          
          #4f46e5,
          #7c3aed,
          #06b6d4
        );

      position:relative;
    }

    /* Animated Background */

    .blob{
      position:absolute;
      border-radius:50%;
      filter:blur(45px);
      opacity:0.6;
      animation:float 10s infinite ease-in-out;
    }

    .blob1{
      width:320px;
      height:320px;
      background:#ff6b6b;
      top:-100px;
      left:-120px;
    }

    .blob2{
      width:260px;
      height:260px;
      background:#ffd93d;
      bottom:-80px;
      right:-80px;
      animation-delay:2s;
    }

    .blob3{
      width:200px;
      height:200px;
      background:#6bcBef;
      top:55%;
      left:65%;
      animation-delay:4s;
    }

    @keyframes float{

      0%{
        transform:
          translateY(0px)
          scale(1);
      }

      50%{
        transform:
          translateY(-30px)
          scale(1.1);
      }

      100%{
        transform:
          translateY(0px)
          scale(1);
      }

    }

    /* Card */

    .container{

      width:90%;
      max-width:420px;

      padding:30px;

      border-radius:24px;

      background:
        rgba(255,255,255,0.14);

      backdrop-filter:blur(20px);

      border:
        1px solid rgba(255,255,255,0.2);

      box-shadow:
        0 8px 32px rgba(0,0,0,0.25);

      position:relative;
      z-index:10;

      animation:fadeIn 1s ease;
    }

    @keyframes fadeIn{

      from{
        opacity:0;
        transform:translateY(30px);
      }

      to{
        opacity:1;
        transform:translateY(0);
      }

    }

    h1{

      color:white;

      text-align:center;

      font-size:2rem;

      margin-bottom:12px;

      font-weight:700;
    }

    .subtitle{

      color:rgba(255,255,255,0.8);

      text-align:center;

      font-size:14px;

      line-height:1.6;

      margin-bottom:30px;
    }

    .error{

      background:
        rgba(255,0,0,0.15);

      color:white;

      padding:12px;

      border-radius:12px;

      margin-bottom:20px;

      text-align:center;

      border:
        1px solid rgba(255,255,255,0.15);
    }

    form{

      display:flex;
      flex-direction:column;
      gap:20px;
    }

    .input-group{
      position:relative;
    }

    input{

      width:100%;

      padding:16px 18px;

      border:none;
      outline:none;

      border-radius:14px;

      background:
        rgba(255,255,255,0.12);

      color:white;

      font-size:15px;

      transition:0.3s ease;

      border:
        1px solid transparent;
    }

    input::placeholder{
      color:rgba(255,255,255,0.7);
    }

    input:focus{

      border-color:white;

      transform:scale(1.02);

      box-shadow:
        0 0 15px rgba(255,255,255,0.3);
    }

    /* Password Toggle */

    .toggle-password{

      position:absolute;

      right:18px;
      top:50%;

      transform:translateY(-50%);

      color:white;

      font-size:13px;

      cursor:pointer;

      user-select:none;
    }

    button{

      padding:16px;

      border:none;
      outline:none;

      border-radius:14px;

      background:white;

      color:#4f46e5;

      font-size:16px;
      font-weight:700;

      cursor:pointer;

      transition:0.3s ease;
    }

    button:hover{

      transform:translateY(-3px);

      box-shadow:
        0 10px 20px rgba(0,0,0,0.2);

      background:#f3f4f6;
    }

    .links{

      margin-top:12px;

      display:flex;
      justify-content:space-between;
      align-items:center;

      flex-wrap:wrap;

      gap:10px;
    }
    /* Divider */

.divider{

  display:flex;
  align-items:center;
  justify-content:center;

  margin:2px 0 22px;

  position:relative;
}

.divider::before,
.divider::after{

  content:"";

  flex:1;

  height:1px;

  background:
    rgba(255,255,255,0.2);
}

.divider span{

  padding:0 14px;

  color:white;

  font-size:13px;

  letter-spacing:1px;
}

/* Google Button */

.google-btn{

  /* width:100%; */

  display:flex;
  align-items:center;
  justify-content:center;

  gap:12px;

  padding:15px;

  border-radius:14px;

  background:
    rgba(255,255,255,0.12);

  border:
    1px solid rgba(255,255,255,0.15);

  backdrop-filter:blur(12px);

  color:white;

  text-decoration:none;

  font-weight:600;

  transition:0.3s ease;
}

.google-btn:hover{

  transform:translateY(-3px);

  background:
    rgba(255,255,255,0.18);

  box-shadow:
    0 10px 20px rgba(0,0,0,0.2);
}

    .links a{

      color:white;

      text-decoration:none;

      font-size:14px;

      font-weight:500;

      transition:0.3s;
    }

    .links a:hover{
      opacity:0.8;
    }

    @media(max-width:500px){

      .container{
        padding:30px;
      }

      h1{
        font-size:1.6rem;
      }

      .links{
        flex-direction:column;
      }

    }

  </style>

</head>

<body>

  <!-- Animated Blobs -->

  <div class="blob blob1"></div>
  <div class="blob blob2"></div>
  <div class="blob blob3"></div>

  <!-- Main Card -->

  <div class="container">

    <h1>
      Welcome Back
    </h1>

    <p class="subtitle">
      Login to continue to your secure dashboard.
    </p>

    <% if(error){ %>

      <div class="error">
        <%= error %>
      </div>

    <% } %>

    <form
      action="/login"
      method="POST"
    >

      <div class="input-group">

        <input
          type="email"
          name="email"
          placeholder="Enter Email"
          autocomplete="email"
          required
        />

      </div>

      <div class="input-group">

        <input
          type="password"
          name="password"
          placeholder="Enter Password"
          autocomplete="current-password"
          id="password"
          required
        />

        <span
          class="toggle-password"
          onclick="togglePassword()"
        >
          Show
        </span>

      </div>

      <button type="submit">
        Login
      </button>

    </form>

   <div class="links">

  <a href="/forgot-password">
    Forgot Password?
  </a>

  <a href="/register">
    Create Account
  </a>

</div>

<!-- Divider -->

<div class="divider">

  <span>
    OR
  </span>

</div>

<!-- Google Login -->

<a
  href="/auth/google"
  class="google-btn"
>

  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 48 48"
    width="22px"
    height="22px"
  >

    <path
      fill="#FFC107"
      d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12S17.4 12 24 12c3 0 5.7 1.1 7.8 2.9l5.7-5.7C34.1 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.5z"
    />

    <path
      fill="#FF3D00"
      d="M6.3 14.7l6.6 4.8C14.7 16 19 12 24 12c3 0 5.7 1.1 7.8 2.9l5.7-5.7C34.1 6.1 29.3 4 24 4c-7.7 0-14.3 4.3-17.7 10.7z"
    />

    <path
      fill="#4CAF50"
      d="M24 44c5.2 0 10-2 13.5-5.3l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.2-8l-6.5 5C9.6 39.5 16.3 44 24 44z"
    />

    <path
      fill="#1976D2"
      d="M43.6 20.5H42V20H24v8h11.3c-1.1 3-3.3 5.5-6.2 7.1l6.2 5.2C39.6 36.5 44 30.8 44 24c0-1.3-.1-2.7-.4-3.5z"
    />

  </svg>

  Continue with Google

</a>

  </div>

  <!-- Password Toggle -->

  <script>

    function togglePassword(){

      const password =
        document.getElementById("password");

      const toggle =
        document.querySelector(".toggle-password");

      if(password.type === "password"){

        password.type = "text";
        toggle.innerText = "Hide";

      }else{

        password.type = "password";
        toggle.innerText = "Show";

      }

    }

  </script>

</body>

</html>